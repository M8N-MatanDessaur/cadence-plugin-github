        "mutates": true,
        "args": [
          {
            "name": "Repo",
            "label": "Repository"
          },
          {
            "name": "Number",
            "label": "PR number"
          },
          {
            "name": "Method",
            "label": "squash | merge | rebase",
            "default": "squash"
          }
        ]
      },
      {
        "file": "Get-Branches.ps1",
        "label": "List branches",
