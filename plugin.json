            "name": "Repo",
            "label": "Repository"
          }
        ]
      },
      {
        "file": "Get-ReleaseDelta.ps1",
        "label": "What goes in the next release",
        "description": "Commits and PRs since a tag, for release notes.",
        "args": [
          {
            "name": "Repo",
            "label": "Repository"
          },
          {
            "name": "From",
            "label": "From tag",
            "default": ""
          }
        ]
      },
      {
        "file": "New-Release.ps1",
        "label": "Create a release",
        "description": "A release on a tag, with notes; draft or prerelease if asked.",
        "mutates": true,
        "args": [
          {
            "name": "Repo",
            "label": "Repository"
          },
          {
            "name": "Tag",
            "label": "Tag"
          },
          {
            "name": "Name",
            "label": "Name",
            "default": ""
          }
        ]
      },
      {
        "file": "Get-Notifications.ps1",
        "label": "My inbox",
        "description": "Unread GitHub notifications.",
        "args": []
      },
      {
        "file": "Clear-Notifications.ps1",
        "label": "Mark notifications read",
        "description": "Marks one thread or all of them read.",
        "mutates": true,
        "args": [
          {
            "name": "Id",
            "label": "Thread id",
            "default": ""
          }
        ]
      },
      {
        "file": "Get-UserRepos.ps1",
        "label": "My GitHub repositories",
        "description": "Repositories the token can see on GitHub.",
        "args": [
          {
            "name": "Query",
            "label": "Filter",
            "default": ""
          }
        ]
      }
    ],
    "handle": {
      "name": "gh",
      "aliases": [
        "github",
        "pr",
        "pull"
      ],
      "description": "GitHub: a pull request or issue by number, or a search across pull requests, issues and repositories",
      "placeholder": "a number (#123), or words to search for",
      "resolve": [
        {
          "pattern": "^(?:PR|pr)?[ ]*#?([0-9]+)$",
          "kind": "pull-request",
          "label": "Pull request or issue #{1}",
          "detail": "GitHub, in the repository the GitHub screen is on",
          "open": {
            "surface": "github",
            "target": {
              "pull": "{1}"
            }
          },
          "mention": "\\b(?:PR|GH) ?#([0-9]+)\\b"
        }
      ],
      "search": {
        "route": "/search",
        "minChars": 2,
        "kinds": [
          "pull-request",
          "issue",
          "repo"
        ]
      },
      "fallback": {
        "surface": "github",
        "target": {
          "query": "{text}"
        }
      }
    }
  }
}
