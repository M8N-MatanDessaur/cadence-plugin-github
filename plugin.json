          },
          {
            "name": "Body",
            "label": "Review text",
            "default": ""
          }
        ]
      },
      {
        "file": "Update-PullRequest.ps1",
        "label": "Edit a pull request",
        "description": "Title, body, base, state, labels, assignees, reviewers.",
        "mutates": true,
        "args": [
          {
            "name": "Repo",
            "label": "Repository"
          },
          {
            "name": "Number",
            "label": "PR number"
          }
        ]
      },
      {
        "file": "Merge-PullRequest.ps1",
        "label": "Merge a pull request",
