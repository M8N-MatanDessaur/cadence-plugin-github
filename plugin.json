{
  "id": "github",
  "name": "GitHub",
  "version": "0.6.2",
  "sdkVersion": 3,
  "description": "GitHub integration: repositories, pull requests, reviews, cloning, git log",
  "icon": "github",
  "tint": "110, 125, 170",
  "instructions": "instructions.md",
  "aiKeywords": [
    "github",
    "git hub",
    "gh",
    "pull request",
    "pr",
    "code review",
    "clone repo",
    "clone from github",
    "github repo",
    "github repos"
  ],
  "activationConditions": {
    "configKeys": [
      "GitHubPAT"
    ]
  },
  "settings": [],
  "contributions": {
    "routes": "routes.js",
    "configKeys": [
      "GitHubPAT"
    ],
    "sensitiveKeys": [
      "GitHubPAT"
    ],
    "nativeSettings": {
      "targetId": "settingsSection-github"
    },
    "centerTabs": [
      {
        "id": "prs",
        "label": "Pull Requests",
        "icon": "git-pull-request",
        "pinned": true,
        "position": 4,
        "claims": {
          "tabBtnId": "prsTabBtn",
          "panelId": "panel-prs"
        },
        "openable": true
      }
    ],
    "repoSources": [
      {
        "id": "github",
        "label": "Clone from GitHub",
        "icon": "github",
        "listRoute": "/api/github/user-repos",
        "cloneRoute": "/api/github/clone"
      }
    ],
    "commitLinkers": [
      {
        "id": "github-pr-ref",
        "pattern": "(?:^|\\s)#(\\d+)\\b",
        "urlTemplate": "https://github.com/{owner}/{repo}/pull/{1}",
        "note": "Matches '#123' in commit messages and resolves via parseGitHubRemote"
      }
    ],
    "prProvider": {
      "id": "github",
      "label": "GitHub",
      "listRoute": "/api/github/pulls",
      "detailRoute": "/api/github/pulls/detail",
      "filesRoute": "/api/github/pulls/files",
      "commentsRoute": "/api/github/pulls/comments",
      "timelineRoute": "/api/github/pulls/timeline",
      "commentRoute": "/api/github/pulls/comment",
      "reviewRoute": "/api/github/pulls/review",
      "createRoute": "/api/pull-request"
    },
    "rightTabs": [
      {
        "id": "gitlog",
        "label": "Git Log",
        "pinned": true,
        "position": 2,
        "claims": {
          "tabBtnId": "intelTab-gitlog",
          "panelId": "ipanel-gitlog"
        }
      }
    ],
    "surfaces": [
      {
        "id": "github",
        "title": "GitHub",
        "icon": "pr",
        "mount": "rail",
        "entry": "ui/github.js",
        "sidebar": true,
        "aside": true,
        "description": "Pull requests, reviews, checks, AI review and summaries, repos to clone."
      }
    ],
    "scripts": [
      {
        "file": "Get-Me.ps1",
        "label": "Who am I",
        "description": "The GitHub account behind the configured token.",
        "args": []
      },
      {
        "file": "Get-ReviewRequests.ps1",
        "label": "Awaiting my review",
        "description": "Open pull requests, on any repository, that ask for your review.",
        "args": []
      },
      {
        "file": "Get-PullRequests.ps1",
        "label": "List pull requests",
        "description": "Open (or closed, or all) pull requests of a repository.",
        "args": [
          {
            "name": "Repo",
            "label": "Repository"
          },
          {
            "name": "State",
            "label": "open | closed | all",
            "default": "open"
          }
        ]
      },
      {
        "file": "Get-PullRequest.ps1",
        "label": "Read a pull request",
        "description": "Everything about one pull request: detail, files, commits, checks, timeline, diff.",
        "args": [
          {
            "name": "Repo",
            "label": "Repository"
          },
          {
            "name": "Number",
            "label": "PR number"
          }
        ]
      },
      {
        "file": "Get-PullRequestDiff.ps1",
        "label": "Diff of a pull request",
        "description": "The unified diff of a pull request, as plain text.",
        "args": [
          {
            "name": "Repo",
            "label": "Repository"
          },
          {
            "name": "Number",
            "label": "PR number"
          }
        ]
      },
      {
        "file": "Add-PullRequestComment.ps1",
        "label": "Comment on a pull request",
        "description": "Posts a comment on a pull request.",
        "mutates": true,
        "args": [
          {
            "name": "Repo",
            "label": "Repository"
          },
          {
            "name": "Number",
            "label": "PR number"
          },
          {
            "name": "Body",
            "label": "Comment"
          }
        ]
      },
      {
