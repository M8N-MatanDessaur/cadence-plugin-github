        "args": [
          {
            "name": "Repo",
            "label": "Repository"
          },
          {
            "name": "Title",
            "label": "Title"
          }
        ]
      },
      {
        "file": "Get-PullRequestChecks.ps1",
        "label": "Checks of a pull request",
        "description": "Checks and statuses on the head commit of a pull request.",
        "args": [
          {
            "name": "Repo",
            "label": "Repository"
          },
          {
            "name": "Number",
            "label": "PR number"
          }
        ]
      },
      {
        "file": "Get-Issues.ps1",
        "label": "List issues",
