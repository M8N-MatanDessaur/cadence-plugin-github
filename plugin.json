        "args": [
          {
            "name": "Repo",
            "label": "Repository"
          },
          {
            "name": "Title",
            "label": "Title"
          },
          {
            "name": "Description",
            "label": "Description",
            "default": ""
          },
          {
            "name": "TargetBranch",
            "label": "Target branch",
            "default": ""
          }
        ]
      },
      {
        "file": "Push-AndPR.ps1",
        "label": "Push and open a PR",
