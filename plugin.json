        "args": [
          {
            "name": "Repo",
            "label": "Repository"
          },
          {
            "name": "Id",
            "label": "Run id"
          }
        ]
      },
      {
        "file": "Restart-ActionRun.ps1",
        "label": "Re-run a workflow",
        "description": "Re-runs an Actions run, or only its failed jobs.",
        "mutates": true,
        "args": [
          {
            "name": "Repo",
            "label": "Repository"
          },
          {
            "name": "Id",
            "label": "Run id"
          }
        ]
      },
      {
        "file": "Get-Releases.ps1",
        "label": "List releases",
