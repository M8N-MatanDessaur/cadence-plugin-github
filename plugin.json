            "default": "open"
          }
        ]
      },
      {
        "file": "Get-Issue.ps1",
        "label": "Read an issue",
        "description": "One issue with its comments, linked pull requests and history.",
        "args": [
          {
            "name": "Repo",
            "label": "Repository"
          },
          {
            "name": "Number",
            "label": "Issue number"
          }
        ]
      },
      {
        "file": "New-Issue.ps1",
        "label": "Create an issue",
        "description": "Opens an issue with a title, a body, labels and assignees.",
        "mutates": true,
        "args": [
          {
            "name": "Repo",
            "label": "Repository"
          },
          {
            "name": "Title",
            "label": "Title"
          },
          {
            "name": "Body",
            "label": "Body",
            "default": ""
          },
          {
            "name": "Labels",
            "label": "Labels (comma separated)",
            "default": ""
          }
        ]
      },
      {
        "file": "Add-IssueComment.ps1",
        "label": "Comment on an issue",
        "description": "Posts a comment on an issue.",
        "mutates": true,
        "args": [
          {
            "name": "Repo",
            "label": "Repository"
          },
          {
            "name": "Number",
            "label": "Issue number"
          },
          {
            "name": "Body",
            "label": "Comment"
          }
        ]
      },
      {
        "file": "Update-Issue.ps1",
        "label": "Edit an issue",
        "description": "State, title, body, labels, assignees.",
        "mutates": true,
        "args": [
          {
            "name": "Repo",
            "label": "Repository"
          },
          {
            "name": "Number",
            "label": "Issue number"
          }
        ]
      },
      {
        "file": "Start-Issue.ps1",
        "label": "Start working on an issue",
        "description": "Cuts a branch named after the issue and assigns it to you.",
        "mutates": true,
        "args": [
          {
            "name": "Repo",
            "label": "Repository"
          },
          {
            "name": "Number",
            "label": "Issue number"
          }
        ]
      },
      {
        "file": "Get-Labels.ps1",
        "label": "List labels",
        "description": "The labels a repository uses.",
        "args": [
          {
            "name": "Repo",
            "label": "Repository"
          }
        ]
      },
      {
        "file": "Get-Collaborators.ps1",
        "label": "List collaborators",
        "description": "Who can be assigned or asked to review on a repository.",
        "args": [
          {
            "name": "Repo",
            "label": "Repository"
          }
        ]
      },
      {
        "file": "Get-Activity.ps1",
        "label": "Recent activity",
        "description": "Commits and events on a repository over the last days.",
        "args": [
          {
            "name": "Repo",
            "label": "Repository"
          },
          {
            "name": "Days",
            "label": "Days back",
            "default": "14"
          }
        ]
      },
      {
        "file": "Get-Team.ps1",
        "label": "The team",
        "description": "Who works on a repository and how much, over 30 days.",
        "args": [
          {
            "name": "Repo",
            "label": "Repository"
          }
        ]
      },
      {
        "file": "Get-ActionRuns.ps1",
        "label": "List workflow runs",
        "description": "Recent GitHub Actions runs, optionally on one branch.",
        "args": [
          {
            "name": "Repo",
            "label": "Repository"
          },
          {
            "name": "Branch",
            "label": "Branch",
            "default": ""
          }
        ]
      },
      {
        "file": "Get-ActionRun.ps1",
        "label": "Read a workflow run",
